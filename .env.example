# Application
APP_ENVIRONMENT=development
APP_TIMEZONE=UTC
APP_SHUTDOWN_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=sensflow
POSTGRES_USER=sensflow
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://sensflow:replace-with-a-strong-password@postgres:5432/sensflow

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_OPERATOR_ID=123456789
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_NOTIFICATION_CATEGORIES=stock_available,low_balance,critical_balance,auto_requeue_started,auto_requeue_completed,auto_requeue_failed,purchase_completed,marketplace_error,synchronization_failed,order_cancelled

# RBXCrate
RBXCRATE_API_KEY=replace-with-rbxcrate-api-key
RBXCRATE_BASE_URL=https://rbxcrate.com
RBXCRATE_DRY_RUN=false

# Roblox (leave empty when the API does not require credentials)
ROBLOX_API_KEY=

# Marketplace defaults
# Replace the example financial values with approved business values.
MIN_PURCHASE_RATE=0
MAX_PURCHASE_RATE=1.0
PREFERRED_PURCHASE_RATE=1.0
PREFERRED_TIMEOUT_MINUTES=35
LOW_BALANCE_THRESHOLD=10
CRITICAL_BALANCE_THRESHOLD=5
STOCK_NOTIFICATIONS_ENABLED=true
MARKETPLACE_COMMISSION_RATE=0.0
STOCK_MONITORING_INTERVAL_SECONDS=5
MARKETPLACE_SYNC_INTERVAL_SECONDS=30

# Automation defaults
AUTOMATIC_REORDER_ENABLED=true
AUTOMATIC_REORDER_INTERVAL_SECONDS=0.3
AUTO_REQUEUE_DELAY_SECONDS=5

# Finance defaults
USD_EXCHANGE_RATE=1.0
